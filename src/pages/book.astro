---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Party Intake - Fam Jam Events"
  description="Send Fam Jam Events the details for DJ, photo booth, vendor planning, and party experience help."
>
  <Nav currentPage="/book" />

  <section class="book-section intake-section">
    <div class="book-inner intake-inner">
      <div class="intake-intro sheet sheet-2">
        <span class="paper-under" aria-hidden="true"></span>
        <span class="paper-top" aria-hidden="true"></span>
        <div class="sheet-body">
          <div class="section-label">Fam Jam Intake</div>
          <h1 class="book-heading">Tell Us What You Are Planning.</h1>
          <p class="sub">
            Use this for DJ, photo booth, vendor planning, and experience help. For The Oasis
            space itself, book through Swimply first so insurance and liability are handled
            correctly.
          </p>
          <a
            href="https://swimply.com/pooldetails/81440?lfl=qDDrfv5K"
            class="btn btn-cyan"
            target="_blank"
            rel="noopener noreferrer"
          >
            Schedule The Space On Swimply
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </div>

      <form
        class="intake-form sheet sheet-4"
        name="fam-jam-intake"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
      >
        <span class="paper-under" aria-hidden="true"></span>
        <span class="paper-top" aria-hidden="true"></span>
        <div class="sheet-body">
          <input type="hidden" name="form-name" value="fam-jam-intake" />
          <p class="visually-hidden">
            <label>Do not fill this out: <input name="bot-field" /></label>
          </p>

          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="form-field">
              <label for="event-date">Event Date</label>
              <input id="event-date" name="event-date" type="date" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="hours">Hours</label>
              <input id="hours" name="hours" type="text" placeholder="Example: 3 hours, 4-8pm" />
            </div>
            <div class="form-field">
              <label for="people">Number Of People</label>
              <input id="people" name="number-of-people" type="number" min="1" inputmode="numeric" />
            </div>
          </div>

          <div class="form-field">
            <label for="occasion">Occasion</label>
            <select id="occasion" name="occasion">
              <option value="">Select one...</option>
              <option>Birthday Party</option>
              <option>Pool Party</option>
              <option>Graduation</option>
              <option>Family Celebration</option>
              <option>Teen Party</option>
              <option>School Event</option>
              <option>Other</option>
            </select>
          </div>

          <fieldset class="form-field services-field">
            <legend>Services Interested In</legend>
            <label><input type="checkbox" name="services-interested-in" value="DJ" /> DJ</label>
            <label><input type="checkbox" name="services-interested-in" value="Photo Booth" /> Photo Booth</label>
            <label><input type="checkbox" name="services-interested-in" value="Vendor Planning" /> Vendor Planning</label>
            <label><input type="checkbox" name="services-interested-in" value="Day-Of Experiences" /> Day-Of Experiences</label>
            <label><input type="checkbox" name="services-interested-in" value="Oasis Party Help" /> Oasis Party Help After Swimply Booking</label>
          </fieldset>

          <div class="form-field">
            <label for="details">Details</label>
            <textarea id="details" name="details" placeholder="Tell us the vibe, music, timeline, must-haves, and anything you already know."></textarea>
          </div>

          <button class="btn btn-pink form-submit" type="submit">Send Intake</button>
        </div>
      </form>
    </div>
  </section>

  <Footer />
</BaseLayout>
