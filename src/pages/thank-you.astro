---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Thanks - Fam Jam Events"
  description="Thanks for sending your Fam Jam Events intake."
>
  <Nav currentPage="/book" />

  <section class="book-section thank-you-section">
    <div class="book-inner thank-you-inner">
      <div class="sheet sheet-2 thank-you-note">
        <span class="paper-under" aria-hidden="true"></span>
        <span class="paper-top" aria-hidden="true"></span>
        <div class="sheet-body">
          <div class="section-label">Received</div>
          <h1 class="book-heading">We Got Your Intake.</h1>
          <p class="sub">
            We will review the date, services, headcount, and party details, then follow up with
            the clearest next step.
          </p>
          <div class="thank-you-actions">
            <a href="/" class="btn btn-outline">Back To The Board</a>
            <a href="tel:3124149698" class="btn btn-pink">Text Fam Jam</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
