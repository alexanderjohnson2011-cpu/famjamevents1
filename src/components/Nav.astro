---
export interface Props {
  currentPage?: string;
}
const { currentPage = '/' } = Astro.props;
---
<nav>
  <a href="/" class="nav-logo">Fam<span class="accent">Jam</span> Events</a>
  <ul class="nav-links" id="nav-links">
    <li><a href="/#party-board">Start Here</a></li>
    <li><a href="https://oasis.famjamevents.com" target="_blank" rel="noopener noreferrer" class="nav-oasis">The Space<span class="visually-hidden"> (opens in a new tab)</span></a></li>
    <li><a href="/music">The Music</a></li>
    <li><a href="/booth">The Photo Booth</a></li>
    <li><a href="/services">Services</a></li>
    <li class="nav-mobile-cta"><a href="/book" class="nav-cta">Intake</a></li>
  </ul>
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>
  <a href="/book" class="nav-cta nav-cta-desktop">Intake</a>
</nav>

<script>
  const burger = document.getElementById('nav-hamburger');
  const links = document.getElementById('nav-links');
  burger?.addEventListener('click', () => {
    links?.classList.toggle('open');
    burger.classList.toggle('open');
  });
  // Close menu when a link is clicked
  links?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('open');
      burger?.classList.remove('open');
    });
  });
</script>

<style>
  .nav-oasis {
    color: var(--craft-teal-dark) !important;
    border-bottom-color: transparent !important;
  }
  .nav-oasis:hover {
    color: var(--craft-teal-dark) !important;
    border-bottom-color: var(--craft-pink) !important;
    opacity: .85;
  }
</style>
