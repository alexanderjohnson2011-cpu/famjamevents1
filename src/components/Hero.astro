---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.webp';
---

<section class="hero home-hero" id="home">
  <div class="hero-left">
    <div class="hero-logo-note sheet sheet-1">
      <span class="paper-under" aria-hidden="true"></span>
      <span class="paper-top" aria-hidden="true"></span>
      <div class="sheet-body">
        <Image
          src={logo}
          alt="Fam Jam Events"
          widths={[360, 540, 720, 1050]}
          sizes="(max-width: 640px) 320px, (max-width: 980px) 510px, 540px"
          format="avif"
          quality={76}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="hero-copy-stack">
      <h1 class="hero-paper-headline sheet sheet-2">
        <span class="paper-under" aria-hidden="true"></span>
        <span class="paper-top" aria-hidden="true"></span>
        <span class="sheet-body headline-stack">
          <span class="headline-word headline-family">Family</span>
          <span class="headline-word headline-parties">Parties</span>
          <span class="headline-word headline-done">Done Right</span>
        </span>
      </h1>
      <p class="hero-sub">
        A backyard venue, real DJ sets, and a DSLR photo booth for parties that feel personal,
        relaxed, and actually fun.
      </p>
      <div class="hero-actions">
        <a href="#party-board" class="btn btn-outline">Pick Your Piece</a>
        <a href="/book" class="btn btn-pink">Start The Intake</a>
      </div>
    </div>
  </div>
</section>
