---
---
<section class="section services-section" id="services">
  <div class="section-inner">
    <div class="centered">
      <div class="section-label">Mix And Match</div>
      <h2>Pick Your Setup</h2>
      <p class="sub" style="margin:0 auto 0;">
        Start with the pieces you need. We will help shape the plan around your crowd,
        timeline, space, and budget before anything is confirmed.
      </p>
    </div>

    <div class="services-grid" style="margin-top:48px;">
      <div class="svc-card featured svc-bundle">
        <span class="svc-icon">Music + Memories</span>
        <div class="svc-name">DJ + Photo Booth</div>
        <div class="svc-desc">One coordinated plan for the sound, the photos, and the moments you do not want people to miss.</div>
        <ul class="svc-features">
          <li>Everything in DJ Service</li>
          <li>Everything in Photo Booth</li>
          <li>Coordinated setup and timing</li>
          <li>One contact for both, start to finish</li>
        </ul>
      </div>

      <div class="svc-card svc-collapsible svc-dj">
        <span class="svc-icon">The Music</span>
        <div class="svc-name">DJ Service</div>
        <button class="svc-toggle" aria-expanded="false">
          See what's included <span class="svc-chevron">&rsaquo;</span>
        </button>
        <div class="svc-body">
          <div class="svc-desc">A real DJ set built around your people, not a generic playlist or canned wedding format.</div>
          <ul class="svc-features">
            <li>Set built around your music preferences</li>
            <li>Three DJs rotating through the event</li>
            <li>Fog machine + lights for night events</li>
            <li>Day-of scripting and mic included</li>
          </ul>
        </div>
      </div>

      <div class="svc-card svc-collapsible svc-booth">
        <span class="svc-icon">The Booth</span>
        <div class="svc-name">Photo Booth</div>
        <button class="svc-toggle" aria-expanded="false">
          See what's included <span class="svc-chevron">&rsaquo;</span>
        </button>
        <div class="svc-body">
          <div class="svc-desc">Walk away with actual prints, not just a shared album link nobody opens.</div>
          <ul class="svc-features">
            <li>Real DSLR camera + flattering lighting</li>
            <li>Custom theme-matched print design</li>
            <li>Onsite attendant the whole time</li>
            <li>High-res digital images per event</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="services-addon-row">
      <div class="addon-card">
        <span class="addon-chip">Optional</span>
        <div class="addon-body">
          <h4>Party Photos &amp; Social Reel</h4>
          <p>We capture photos and short video clips throughout the event and cut them into a social reel. Not a full event photographer, just us documenting the vibe as it happens.</p>
        </div>
        <div class="addon-price">Ask Us<span>when you send the intake</span></div>
      </div>
    </div>

    <div class="services-cta">
      <a href="/book" class="btn btn-pink">Start The Intake</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.svc-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.svc-collapsible');
      const isOpen = card.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
